# Shared camera login. AMCREST_USERNAME/PASSWORD are also accepted.
CAMERA_USERNAME=admin
CAMERA_PASSWORD=

# Defaults to this computer only. To allow other devices on the LAN,
# set HOST=0.0.0.0 and set a dashboard password. Login user: operator.
HOST=127.0.0.1
PORT=8088
DASHBOARD_PASSWORD=

# Optional overrides:
# CAMERAS_FILE=cameras.local.json
# GO2RTC_BIN=/absolute/path/to/go2rtc
# GO2RTC_PORT=1984
